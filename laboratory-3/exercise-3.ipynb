   "source": [
    "#EXERCISE 3\n",
    "import numpy as np\n",
    "\n",
    "first_sequence = [0,1,2,3,0,0,0,0,0]\n",
    "second_sequence = [0,0,1,2,0,0,0,0,0]\n",
    "\n",
    "correlation = np.correlate(first_sequence, second_sequence, mode = 'full')\n",
    "\n",
    "\n",
    "print(f\"The full correlation array: {correlation}\")\n",
    "print(f\"The maximum: {correlation.max()}\")"
   ]
  }
 ],
