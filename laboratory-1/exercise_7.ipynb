   "source": [
    "from random import uniform\n",
    "\n",
    "def configurable_rand(start, stop, length):\n",
    "    random_numbers = []\n",
    "    for x in range(length):\n",
    "        random_numbers.append(uniform(start, stop))\n",
    "\n",
    "    return random_numbers\n",
    "\n",
    "configurable_rand(0, 10, 5)\n",
    "        \n"
   ]
  }
